{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4s:marchem-candidate-verification:v1",
  "title": "MarChem candidate export verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verification_version",
    "source_id",
    "acquisition",
    "archive",
    "observed_data",
    "observed_metadata",
    "prepared_human_review_sample",
    "human_review",
    "claim_boundary"
  ],
  "properties": {
    "verification_version": {"const": "marchem-candidate-verification-v1"},
    "source_id": {"const": "norway-marchem"},
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_url",
        "observed_at",
        "response_content_type",
        "publisher_checksum_available"
      ],
      "properties": {
        "request_url": {"type": "string", "pattern": "^https://marchem-api\\.hi\\.no/"},
        "observed_at": {"type": "string", "format": "date-time"},
        "response_content_type": {"const": "application/zip"},
        "publisher_checksum_available": {"const": false}
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "bytes", "members", "dynamic_export_filenames"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "members": {
          "type": "array",
          "minItems": 3,
          "items": {"$ref": "#/$defs/member"}
        },
        "dynamic_export_filenames": {"type": "boolean"}
      }
    },
    "observed_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_record_count",
        "distinct_sample_code_count",
        "duplicate_sample_code_count",
        "target_bearing_row_count",
        "sample_codes_with_target_count",
        "sample_codes_without_target_count",
        "sample_codes_with_multiple_target_rows_count",
        "distinct_batch_count",
        "batches",
        "cruise_years",
        "longitude_range",
        "latitude_range",
        "target_analytes"
      ],
      "properties": {
        "data_record_count": {"type": "integer", "minimum": 1},
        "distinct_sample_code_count": {"type": "integer", "minimum": 1},
        "duplicate_sample_code_count": {"type": "integer", "minimum": 0},
        "target_bearing_row_count": {"type": "integer", "minimum": 1},
        "sample_codes_with_target_count": {"type": "integer", "minimum": 1},
        "sample_codes_without_target_count": {"type": "integer", "minimum": 0},
        "sample_codes_with_multiple_target_rows_count": {"type": "integer", "minimum": 0},
        "distinct_batch_count": {"type": "integer", "minimum": 1},
        "batches": {"$ref": "#/$defs/uniqueStrings"},
        "cruise_years": {"$ref": "#/$defs/uniqueStrings"},
        "longitude_range": {"$ref": "#/$defs/range"},
        "latitude_range": {"$ref": "#/$defs/range"},
        "target_analytes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["As", "Cu", "Ni", "Zn"],
          "properties": {
            "As": {"$ref": "#/$defs/analyteProfile"},
            "Cu": {"$ref": "#/$defs/analyteProfile"},
            "Ni": {"$ref": "#/$defs/analyteProfile"},
            "Zn": {"$ref": "#/$defs/analyteProfile"}
          }
        }
      }
    },
    "observed_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata_record_count",
        "target_metadata_record_count",
        "target_batches",
        "target_llq_values_mg_per_kg",
        "accreditation_rows",
        "partial_digestion_disclosed",
        "not_total_content_disclosed"
      ],
      "properties": {
        "metadata_record_count": {"type": "integer", "minimum": 1},
        "target_metadata_record_count": {"type": "integer", "minimum": 1},
        "target_batches": {"$ref": "#/$defs/elementStringLists"},
        "target_llq_values_mg_per_kg": {"$ref": "#/$defs/elementStringLists"},
        "accreditation_rows": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accredited", "not_accredited", "unclear"],
          "properties": {
            "accredited": {"type": "integer", "minimum": 0},
            "not_accredited": {"type": "integer", "minimum": 0},
            "unclear": {"type": "integer", "minimum": 0}
          }
        },
        "partial_digestion_disclosed": {"type": "boolean"},
        "not_total_content_disclosed": {"type": "boolean"}
      }
    },
    "prepared_human_review_sample": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/reviewRow"}
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_record_count", "prepared_record_count", "status"],
      "properties": {
        "required_record_count": {"type": "integer", "minimum": 1},
        "prepared_record_count": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "enum": ["pending", "pass", "fail"]}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bytes"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "number"}
    },
    "analyteProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_column",
        "reported_unit",
        "weight_basis",
        "record_count",
        "present_count",
        "missing_count",
        "numeric_count",
        "censored_lt_count",
        "censored_gt_count",
        "invalid_count",
        "reported_numeric_min",
        "reported_numeric_max"
      ],
      "properties": {
        "source_column": {"type": "string", "minLength": 1},
        "reported_unit": {"const": "mg/kg"},
        "weight_basis": {"const": "dry"},
        "record_count": {"type": "integer", "minimum": 1},
        "present_count": {"type": "integer", "minimum": 0},
        "missing_count": {"type": "integer", "minimum": 0},
        "numeric_count": {"type": "integer", "minimum": 0},
        "censored_lt_count": {"type": "integer", "minimum": 0},
        "censored_gt_count": {"type": "integer", "minimum": 0},
        "invalid_count": {"type": "integer", "minimum": 0},
        "reported_numeric_min": {"type": ["number", "null"]},
        "reported_numeric_max": {"type": ["number", "null"]}
      }
    },
    "elementStringLists": {
      "type": "object",
      "additionalProperties": false,
      "required": ["As", "Cu", "Ni", "Zn"],
      "properties": {
        "As": {"$ref": "#/$defs/uniqueStrings"},
        "Cu": {"$ref": "#/$defs/uniqueStrings"},
        "Ni": {"$ref": "#/$defs/uniqueStrings"},
        "Zn": {"$ref": "#/$defs/uniqueStrings"}
      }
    },
    "reviewRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_row_number",
        "sample_code",
        "batch_code",
        "cruise_year",
        "longitude",
        "latitude",
        "target_raw_values",
        "selection_reasons"
      ],
      "properties": {
        "source_row_number": {"type": "integer", "minimum": 2},
        "sample_code": {"type": "string", "minLength": 1},
        "batch_code": {"type": "string", "minLength": 1},
        "cruise_year": {"type": "string", "pattern": "^\\d{4}$"},
        "longitude": {"type": "string", "minLength": 1},
        "latitude": {"type": "string", "minLength": 1},
        "target_raw_values": {
          "type": "object",
          "additionalProperties": false,
          "required": ["As", "Cu", "Ni", "Zn"],
          "properties": {
            "As": {"type": "string"},
            "Cu": {"type": "string"},
            "Ni": {"type": "string"},
            "Zn": {"type": "string"}
          }
        },
        "selection_reasons": {"$ref": "#/$defs/uniqueStrings"}
      }
    }
  }
}
