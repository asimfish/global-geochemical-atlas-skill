{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:global-geochemical-atlas:research-delivery-receipt:v3",
  "title": "Online research delivery receipt",
  "description": "Binds the root-level sixteen-file atlas package to one immutable validated loop round. delivery_ready additionally requires a converged online loop, a sufficient v5 assessment, a clear D1 repair queue and an unchanged executable Skill snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_sha256",
    "published_round",
    "published_round_dir",
    "loop_status",
    "loop_stop_reason",
    "sufficiency_status",
    "execution_mode",
    "checkpoint_only",
    "d1_repair_queue_status",
    "control_files",
    "skill_snapshot",
    "delivery_ready",
    "artifacts",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "atlas-research-delivery-receipt-v3"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "published_round": {"type": "integer", "minimum": 1},
    "published_round_dir": {
      "type": "string",
      "pattern": "^rounds/round-(?:0[1-9]|1[0-9]|2[0-4])$"
    },
    "loop_status": {
      "type": "string",
      "enum": ["success", "partial_success", "needs_human_review", "failed"]
    },
    "loop_stop_reason": {"type": "string", "minLength": 1},
    "sufficiency_status": {"type": "string", "enum": ["sufficient", "insufficient"]},
    "execution_mode": {"type": ["string", "null"]},
    "checkpoint_only": {"type": "boolean"},
    "d1_repair_queue_status": {"type": "string", "enum": ["clear", "pending"]},
    "control_files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loop_report_sha256", "d1_repair_queue_sha256", "execution_sha256"
      ],
      "properties": {
        "loop_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "d1_repair_queue_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "execution_sha256": {
          "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "skill_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm", "execution_sha256", "current_sha256",
        "matches_execution", "file_count", "total_bytes"
      ],
      "properties": {
        "algorithm": {"const": "skill-tree-sha256-v1"},
        "execution_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "current_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "matches_execution": {"type": "boolean"},
        "file_count": {"type": "integer", "minimum": 1},
        "total_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "delivery_ready": {"type": "boolean"},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geochemistry.csv",
        "source_manifest.json",
        "record_evidence.jsonl",
        "qc_report.json",
        "confidence_report.json",
        "sources_and_confidence.json",
        "batch_acceptance.csv",
        "batch_qc_report.json",
        "anomalies.geojson",
        "anomaly_report.json",
        "anomaly_regions.geojson",
        "spatial_anomaly_report.json",
        "samples.geojson",
        "interactive_map.html",
        "iteration_backlog.csv",
        "run_summary.json"
      ],
      "properties": {
        "geochemistry.csv": {"$ref": "#/$defs/artifact"},
        "source_manifest.json": {"$ref": "#/$defs/artifact"},
        "record_evidence.jsonl": {"$ref": "#/$defs/artifact"},
        "qc_report.json": {"$ref": "#/$defs/artifact"},
        "confidence_report.json": {"$ref": "#/$defs/artifact"},
        "sources_and_confidence.json": {"$ref": "#/$defs/artifact"},
        "batch_acceptance.csv": {"$ref": "#/$defs/artifact"},
        "batch_qc_report.json": {"$ref": "#/$defs/artifact"},
        "anomalies.geojson": {"$ref": "#/$defs/artifact"},
        "anomaly_report.json": {"$ref": "#/$defs/artifact"},
        "anomaly_regions.geojson": {"$ref": "#/$defs/artifact"},
        "spatial_anomaly_report.json": {"$ref": "#/$defs/artifact"},
        "samples.geojson": {"$ref": "#/$defs/artifact"},
        "interactive_map.html": {"$ref": "#/$defs/artifact"},
        "iteration_backlog.csv": {"$ref": "#/$defs/artifact"},
        "run_summary.json": {"$ref": "#/$defs/artifact"}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_sha256", "round_sha256"],
      "properties": {
        "root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "round_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
