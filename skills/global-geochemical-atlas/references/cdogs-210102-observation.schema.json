{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4s:d1-cdogs-210102-observation:v1",
  "title": "D1 CDoGS survey 210102 source-native observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "observation_id", "source_id", "upstream_lineage_id", "survey_key",
    "dataset_version", "package_id", "file_id", "source_row", "source_locator",
    "lab_sample_id", "lab_key", "bundle_key", "site_id", "field_sample_id",
    "control_reference_id", "qaqc_block_id", "qaqc_sample_id", "analysis_order",
    "medium", "sample_type_raw", "sample_type", "sediment_environment", "water_body_type",
    "water_fraction", "preparation_raw", "grain_fraction_raw", "latitude_nad83",
    "longitude_nad83", "source_crs", "coordinate_status", "analyte_reported", "value_raw",
    "parsed_value", "value_qualifier", "unit_raw", "detection_limit", "detection_limit_unit",
    "measurement_basis_raw", "method_id", "method_scope", "method_assignment_basis",
    "analytical_technique", "digestion_or_extraction", "laboratory", "analysis_year",
    "method_source_locator", "publication_id", "publication_citation", "sampled_year_raw",
    "sampling_time_note", "access_status", "research_use_status", "license_id",
    "license_url", "redistribution_status"
  ],
  "properties": {
    "schema_version": {"const": "d1-cdogs-210102-observation-v1"},
    "observation_id": {"type": "string", "minLength": 1},
    "source_id": {"enum": ["cdogs-210102-lake-sediment", "cdogs-210102-lake-water"]},
    "upstream_lineage_id": {"const": "cdogs-survey-210102"},
    "survey_key": {"const": "21:0102"},
    "dataset_version": {"const": "cdogs-svy210102-page-2025-05-18"},
    "package_id": {"type": "string", "minLength": 1},
    "file_id": {"type": "string", "minLength": 1},
    "source_row": {"type": "integer", "minimum": 2},
    "source_locator": {"type": "string", "format": "uri"},
    "lab_sample_id": {"type": ["string", "null"]},
    "lab_key": {"type": ["string", "null"]},
    "bundle_key": {"type": ["string", "null"]},
    "site_id": {"type": ["string", "null"]},
    "field_sample_id": {"type": ["string", "null"]},
    "control_reference_id": {"type": ["string", "null"]},
    "qaqc_block_id": {"type": ["string", "null"]},
    "qaqc_sample_id": {"type": ["string", "null"]},
    "analysis_order": {"type": ["integer", "null"]},
    "medium": {"enum": ["sediment", "water"]},
    "sample_type_raw": {"type": "string", "minLength": 1},
    "sample_type": {"enum": ["sediment_lake", "water_lake"]},
    "sediment_environment": {"type": ["string", "null"]},
    "water_body_type": {"type": ["string", "null"]},
    "water_fraction": {"type": ["string", "null"]},
    "preparation_raw": {"type": ["string", "null"]},
    "grain_fraction_raw": {"type": ["string", "null"]},
    "latitude_nad83": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "longitude_nad83": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
    "source_crs": {"const": "EPSG:4269"},
    "coordinate_status": {"enum": ["source_native_nad83", "missing"]},
    "analyte_reported": {"type": "string", "minLength": 1},
    "value_raw": {"type": "string", "minLength": 1},
    "parsed_value": {"type": ["number", "null"]},
    "value_qualifier": {"enum": ["reported", "lt", "gt", "missing", "rejected", "non_numeric"]},
    "unit_raw": {"type": "string", "minLength": 1},
    "detection_limit": {"type": "number", "minimum": 0},
    "detection_limit_unit": {"type": "string", "minLength": 1},
    "measurement_basis_raw": {"type": ["string", "null"]},
    "method_id": {"type": "string", "minLength": 1},
    "method_scope": {"const": "package_column"},
    "method_assignment_basis": {"const": "official_cdogs_package_column_method_table"},
    "analytical_technique": {"type": "string", "minLength": 1},
    "digestion_or_extraction": {"type": ["string", "null"]},
    "laboratory": {"type": "string", "minLength": 1},
    "analysis_year": {"type": "integer", "minimum": 1900},
    "method_source_locator": {"type": "string", "format": "uri"},
    "publication_id": {"enum": ["GSC-OF-405", "GSC-OF-899"]},
    "publication_citation": {"type": "string", "minLength": 1},
    "sampled_year_raw": {"type": ["integer", "null"]},
    "sampling_time_note": {"type": "string", "minLength": 1},
    "access_status": {"const": "open_public_download"},
    "research_use_status": {"const": "public_research_use"},
    "license_id": {"const": "government-of-canada-website-terms"},
    "license_url": {"type": "string", "format": "uri"},
    "redistribution_status": {"const": "not_assessed_not_required_for_research_use"}
  }
}
