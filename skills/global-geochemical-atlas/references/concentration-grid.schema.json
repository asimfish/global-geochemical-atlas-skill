{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:global-geochemical-atlas:concentration-grid:v1",
  "title": "Observed-cell concentration summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type", "grid_version", "element", "input_sha256", "grid_degrees",
    "feature_count", "interpolation", "scientific_boundary", "features"
  ],
  "properties": {
    "type": {"const": "FeatureCollection"},
    "grid_version": {"const": "d3-observed-concentration-grid-v1"},
    "element": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "grid_degrees": {"enum": [1, 2, 5]},
    "feature_count": {"type": "integer", "minimum": 0},
    "interpolation": {"const": false},
    "scientific_boundary": {"type": "string", "minLength": 1},
    "features": {"type": "array", "items": {"$ref": "#/$defs/feature"}}
  },
  "$defs": {
    "nullableText": {"type": ["string", "null"]},
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "medium", "material", "sample_type", "measurement_basis", "normalized_unit",
        "matched_geologic_unit", "geologic_unit_raw", "analytical_method", "method_family",
        "method_scope", "digestion_or_extraction"
      ],
      "properties": {
        "medium": {"$ref": "#/$defs/nullableText"},
        "material": {"$ref": "#/$defs/nullableText"},
        "sample_type": {"$ref": "#/$defs/nullableText"},
        "measurement_basis": {"$ref": "#/$defs/nullableText"},
        "normalized_unit": {"$ref": "#/$defs/nullableText"},
        "matched_geologic_unit": {"$ref": "#/$defs/nullableText"},
        "geologic_unit_raw": {"$ref": "#/$defs/nullableText"},
        "analytical_method": {"$ref": "#/$defs/nullableText"},
        "method_family": {"$ref": "#/$defs/nullableText"},
        "method_scope": {"$ref": "#/$defs/nullableText"},
        "digestion_or_extraction": {"$ref": "#/$defs/nullableText"}
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "geometry", "properties"],
      "properties": {
        "type": {"const": "Feature"},
        "id": {"type": "string", "pattern": "^cell-[0-9a-f]{20}$"},
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": {"const": "Polygon"},
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {"type": "number", "minimum": -180, "maximum": 180},
                    {"type": "number", "minimum": -90, "maximum": 90}
                  ],
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          }
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "element", "grid_degrees", "record_count", "physical_sample_count",
            "quantified_count", "censored_count", "unquantified_count", "censored_fraction",
            "median", "q25", "q75", "layer", "aggregation"
          ],
          "properties": {
            "element": {"type": "string", "minLength": 1},
            "grid_degrees": {"enum": [1, 2, 5]},
            "record_count": {"type": "integer", "minimum": 1},
            "physical_sample_count": {"type": "integer", "minimum": 1},
            "quantified_count": {"type": "integer", "minimum": 0},
            "censored_count": {"type": "integer", "minimum": 0},
            "unquantified_count": {"type": "integer", "minimum": 0},
            "censored_fraction": {"type": "number", "minimum": 0, "maximum": 1},
            "median": {"type": ["number", "null"], "minimum": 0},
            "q25": {"type": ["number", "null"], "minimum": 0},
            "q75": {"type": ["number", "null"], "minimum": 0},
            "layer": {"$ref": "#/$defs/layer"},
            "aggregation": {"const": "observed_records_only_no_interpolation"}
          }
        }
      }
    }
  }
}
