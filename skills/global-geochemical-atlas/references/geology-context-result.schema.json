{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4s:d1-geology-context-result:v1",
  "title": "D1 independent geologic context match result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "sample_id", "latitude", "longitude", "geologic_unit_raw",
    "matched_geologic_unit", "geology_map_source", "geology_map_source_id",
    "geology_map_version", "match_method", "match_scale", "boundary_distance_m",
    "match_uncertainty", "match_status", "match_candidates", "source_endpoint",
    "source_license", "accessed_at", "cache_status", "error"
  ],
  "properties": {
    "schema_version": {"const": "d1-geology-context-result-v1"},
    "sample_id": {"type": "string", "minLength": 1},
    "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
    "geologic_unit_raw": {"type": ["string", "null"]},
    "matched_geologic_unit": {"type": ["string", "null"]},
    "geology_map_source": {"type": ["string", "null"]},
    "geology_map_source_id": {"type": ["string", "null"]},
    "geology_map_version": {"type": ["string", "null"]},
    "match_method": {"type": ["string", "null"]},
    "match_scale": {"type": ["string", "null"]},
    "boundary_distance_m": {"type": ["number", "null"], "minimum": 0},
    "match_uncertainty": {"type": ["string", "null"]},
    "match_status": {
      "type": "string",
      "enum": [
        "matched", "ambiguous", "unmatched", "failed",
        "not_attempted_missing_coordinate"
      ]
    },
    "match_candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "source_endpoint": {"type": ["string", "null"], "format": "uri"},
    "source_license": {"type": ["string", "null"]},
    "accessed_at": {"type": ["string", "null"], "format": "date-time"},
    "cache_status": {
      "type": "string",
      "enum": ["online", "cache", "fixture", "not_applicable", "failed"]
    },
    "error": {"type": ["string", "null"]}
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "map_id", "source_id", "unit_name", "strat_name", "lithology",
        "top_age_ma", "bottom_age_ma", "source_reference", "map_scale"
      ],
      "properties": {
        "map_id": {"type": ["string", "null"]},
        "source_id": {"type": ["string", "null"]},
        "unit_name": {"type": ["string", "null"]},
        "strat_name": {"type": ["string", "null"]},
        "lithology": {"type": ["string", "null"]},
        "top_age_ma": {"type": ["number", "null"]},
        "bottom_age_ma": {"type": ["number", "null"]},
        "source_reference": {"type": ["string", "null"]},
        "map_scale": {"type": ["string", "null"]}
      }
    }
  }
}
