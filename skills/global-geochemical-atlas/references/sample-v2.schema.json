{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4s:d1-sample:v2",
  "title": "D1 V4 material sample archive entity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "sample_id", "native_sample_id", "igsn", "parent_sample_id", "sampling_event_id",
    "medium_raw", "material_raw", "sample_type_raw", "sample_type", "sample_type_mapping_status",
    "geographic_context_raw", "survey_area", "map_sheet", "cruise_track", "lithology_raw", "lithology",
    "geologic_unit_raw", "geologic_age_raw", "tectonic_setting_raw", "matched_geologic_unit",
    "geology_map_source", "geology_map_version", "match_method", "match_scale", "boundary_distance_m",
    "match_uncertainty", "soil_horizon_raw", "soil_horizon", "sediment_environment", "grain_fraction_raw",
    "water_body_type", "water_fraction", "filtered_state_raw", "description_raw", "missing_reasons"
  ],
  "properties": {
    "schema_version": {"const": "d1-sample-v2"},
    "sample_id": {"type": "string", "minLength": 1},
    "native_sample_id": {"type": ["string", "null"]},
    "igsn": {"type": ["string", "null"]},
    "parent_sample_id": {"type": ["string", "null"]},
    "sampling_event_id": {"type": "string", "minLength": 1},
    "medium_raw": {"type": "string", "minLength": 1},
    "material_raw": {"type": ["string", "null"]},
    "sample_type_raw": {"type": ["string", "null"]},
    "sample_type": {"type": ["string", "null"]},
    "sample_type_mapping_status": {"type": ["string", "null"], "enum": ["exact", "dataset_constant", "mapped", "unmapped", null]},
    "geographic_context_raw": {"type": ["string", "null"]},
    "survey_area": {"type": ["string", "null"]},
    "map_sheet": {"type": ["string", "null"]},
    "cruise_track": {"type": ["string", "null"]},
    "lithology_raw": {"type": ["string", "null"]},
    "lithology": {"type": ["string", "null"]},
    "geologic_unit_raw": {"type": ["string", "null"]},
    "geologic_age_raw": {"type": ["string", "null"]},
    "tectonic_setting_raw": {"type": ["string", "null"]},
    "matched_geologic_unit": {"type": ["string", "null"]},
    "geology_map_source": {"type": ["string", "null"]},
    "geology_map_version": {"type": ["string", "null"]},
    "match_method": {"type": ["string", "null"]},
    "match_scale": {"type": ["string", "null"]},
    "boundary_distance_m": {"type": ["number", "null"], "minimum": 0},
    "match_uncertainty": {"type": ["string", "null"]},
    "soil_horizon_raw": {"type": ["string", "null"]},
    "soil_horizon": {"type": ["string", "null"]},
    "sediment_environment": {"type": ["string", "null"]},
    "grain_fraction_raw": {"type": ["string", "null"]},
    "water_body_type": {"type": ["string", "null"]},
    "water_fraction": {"type": ["string", "null"]},
    "filtered_state_raw": {"type": ["string", "null"]},
    "description_raw": {"type": ["string", "null"]},
    "missing_reasons": {"$ref": "#/$defs/missingReasons"}
  },
  "$defs": {
    "missingReasons": {
      "type": "object",
      "additionalProperties": {"type": "string", "enum": ["not_reported", "not_applicable", "not_available", "redacted", "parse_failed"]}
    }
  }
}
