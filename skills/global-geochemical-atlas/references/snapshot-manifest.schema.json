{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4s:geochemical-source-snapshot:v4",
  "title": "D1 no-content-hash source snapshot",
  "description": "V4 identifies source snapshots with DOI/PID, version, request, file identity, byte counts, schema, row counts and key statistics. Historical hash fields are not part of this contract.",
  "type": "object",
  "additionalProperties": true,
  "required": ["snapshot_version", "snapshot_id", "source_id", "observed_at", "archive", "counts", "claim_boundary"],
  "properties": {
    "snapshot_version": {
      "type": "string",
      "enum": ["geochemical-dynamic-snapshot-v4", "geochemical-source-snapshot-v2-no-content-hash"]
    },
    "snapshot_id": {"type": "string", "minLength": 1},
    "snapshot_kind": {"type": "string"},
    "source_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "dataset_doi": {"type": ["string", "null"]},
    "dataset_version": {"type": ["string", "null"]},
    "request": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "method": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "endpoint": {"type": "string", "format": "uri"},
        "parameters": {"type": "array"}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
        "http_status_evidence": {"type": "string"},
        "content_type": {"type": "string"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": true,
      "required": ["members"],
      "properties": {
        "filename": {"type": "string"},
        "member_count": {"type": "integer", "minimum": 0},
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name", "bytes"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "file_id": {"type": "string"},
              "source_url": {"type": "string"},
              "bytes": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "schema": {"type": "object"},
    "counts": {"type": "object", "minProperties": 1},
    "actual_scope": {"type": "object"},
    "software": {"type": "object"},
    "research_use": {"type": "object"},
    "evidence": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
