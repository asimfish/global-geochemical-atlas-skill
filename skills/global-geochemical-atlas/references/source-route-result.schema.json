{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4s:geochemical-source-route-result:v5",
  "title": "D1 evidence-aware source routing result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route_version",
    "status",
    "request",
    "selected_sources",
    "review_sources",
    "coverage",
    "breadth_audit",
    "limitations",
    "claim_boundary"
  ],
  "properties": {
    "route_version": {"const": "geochemical-source-route-v5"},
    "status": {"type": "string", "enum": ["ready", "partial", "needs_human_review", "unsupported_scope"]},
    "request": {"type": "object"},
    "selected_sources": {"type": "array", "items": {"$ref": "#/$defs/routeSource"}},
    "review_sources": {"type": "array", "items": {"$ref": "#/$defs/routeSource"}},
    "coverage": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "selected_sources", "candidate_sources", "note"],
        "properties": {
          "status": {"type": "string", "enum": ["covered", "partial", "uncovered", "unknown", "restricted"]},
          "selected_sources": {"$ref": "#/$defs/uniqueStrings"},
          "candidate_sources": {"$ref": "#/$defs/uniqueStrings"},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "breadth_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage_mode", "elements", "media", "claim_boundary"],
      "properties": {
        "coverage_mode": {"type": "string", "enum": ["fixed", "maximize_evidence_breadth"]},
        "elements": {"$ref": "#/$defs/breadthDimension"},
        "media": {"$ref": "#/$defs/breadthDimension"},
        "claim_boundary": {"type": "string", "minLength": 1}
      }
    },
    "limitations": {"$ref": "#/$defs/uniqueStrings"},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "breadthDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_required", "audited_candidates", "items"],
      "properties": {
        "minimum_required": {"type": ["integer", "null"], "minimum": 1},
        "audited_candidates": {"$ref": "#/$defs/uniqueStrings"},
        "items": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "selected_sources", "candidate_sources"],
            "properties": {
              "status": {"type": "string", "enum": ["selected", "review_only", "uncovered"]},
              "selected_sources": {"$ref": "#/$defs/uniqueStrings"},
              "candidate_sources": {"$ref": "#/$defs/uniqueStrings"}
            }
          }
        }
      }
    },
    "routeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "status",
        "access_status",
        "research_use_status",
        "evidence_tier",
        "source_evidence_score",
        "use_mode",
        "attribution_note",
        "matching_media",
        "coverage_extent",
        "request_compatibility",
        "reason"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "access_status": {"$ref": "#/$defs/accessStatus"},
        "research_use_status": {"$ref": "#/$defs/researchUseStatus"},
        "evidence_tier": {"$ref": "#/$defs/evidenceTier"},
        "source_evidence_score": {"type": "number", "minimum": 0, "maximum": 100},
        "use_mode": {"$ref": "#/$defs/useMode"},
        "attribution_note": {"type": "string"},
        "matching_media": {"$ref": "#/$defs/uniqueStrings"},
        "coverage_extent": {"type": "string", "minLength": 1},
        "request_compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["media", "analytes", "region", "geology", "measurement_basis", "time_range", "max_records"],
          "properties": {
            "media": {"$ref": "#/$defs/compatibilityDimension"},
            "analytes": {"$ref": "#/$defs/compatibilityDimension"},
            "region": {"$ref": "#/$defs/compatibilityDimension"},
            "geology": {"$ref": "#/$defs/compatibilityDimension"},
            "measurement_basis": {"$ref": "#/$defs/compatibilityDimension"},
            "time_range": {"$ref": "#/$defs/compatibilityDimension"},
            "max_records": {"$ref": "#/$defs/compatibilityDimension"}
          }
        },
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "compatibilityDimension": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["compatible", "compatible_reported_only", "incompatible", "unverified", "not_applicable", "enforced_downstream"]
        }
      },
      "additionalProperties": true
    },
    "accessStatus": {
      "type": "string",
      "enum": ["open", "account_required", "application_required", "restricted", "unavailable"]
    },
    "researchUseStatus": {
      "type": "string",
      "enum": ["open_research", "attribution_required", "noncommercial_research_only", "permission_required", "unknown"]
    },
    "evidenceTier": {"type": "string", "enum": ["A", "B", "C", "D", "U"]},
    "useMode": {
      "type": "string",
      "enum": ["discovery", "raw_observation", "normalized_analysis", "benchmark_ready"]
    }
  }
}
