{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4s:geochemical-source-route-result:v1",
  "title": "D1 source routing result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route_version",
    "status",
    "request",
    "selected_sources",
    "review_sources",
    "coverage",
    "limitations",
    "claim_boundary"
  ],
  "properties": {
    "route_version": {"const": "geochemical-source-route-v1"},
    "status": {"type": "string", "enum": ["ready", "partial", "needs_human_review", "unsupported_scope"]},
    "request": {"type": "object"},
    "selected_sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/routeSource"}
    },
    "review_sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/routeSource"}
    },
    "coverage": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "approved_sources", "candidate_sources", "note"],
        "properties": {
          "status": {"type": "string", "enum": ["covered", "partial", "uncovered", "unknown"]},
          "approved_sources": {"$ref": "#/$defs/uniqueStrings"},
          "candidate_sources": {"$ref": "#/$defs/uniqueStrings"},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {"$ref": "#/$defs/uniqueStrings"},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "routeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "status", "matching_media", "coverage_extent", "reason"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "matching_media": {"$ref": "#/$defs/uniqueStrings"},
        "coverage_extent": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
