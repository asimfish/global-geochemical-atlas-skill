{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4s:global-geochemical-atlas:d3-visualization-report-v1",
  "title": "D3 visualization report",
  "type": "object",
  "required": ["interface_version", "status", "outputs", "limitations", "next_actions"],
  "properties": {
    "interface_version": {"const": "d3-visualization-interface-v1"},
    "status": {"enum": ["success", "invalid_input", "unsupported_scope", "incomplete_retrieval", "needs_human_review"]},
    "input_contract": {"type": "string"},
    "inputs": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "profile_input": {
      "type": "object",
      "required": ["filename", "sha256"],
      "properties": {
        "filename": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "profile": {"$ref": "urn:ai4s:global-geochemical-atlas:d3-visualization-profile-v2"},
    "profile_warnings": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "object", "additionalProperties": {"type": "string"}},
    "output_sha256": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "map_report": {"type": "object"},
    "iteration_backlog": {
      "type": "object",
      "required": ["schema_version", "item_count", "status_counts", "owner_counts", "issue_counts"],
      "properties": {
        "schema_version": {"const": "geochemistry-iteration-backlog-v1"},
        "record_count": {"type": "integer", "minimum": 0},
        "item_count": {"type": "integer", "minimum": 0},
        "status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "owner_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "issue_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      },
      "additionalProperties": false
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "next_actions": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "success"}}},
      "then": {
        "required": [
          "input_contract",
          "inputs",
          "profile_input",
          "profile",
          "profile_warnings",
          "output_sha256",
          "map_report",
          "iteration_backlog"
        ]
      }
    }
  ],
  "additionalProperties": false
}
