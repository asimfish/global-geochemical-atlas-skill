{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4s:geochemistry-record:d2-v2",
  "title": "D2 v2 standardized geochemical measurement record",
  "description": "One analyte determination with source-row provenance, preserved reported values, conservative normalization, QC and operational confidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "source_record_id",
    "sample_id",
    "sample_identity_group",
    "replicate_group_id",
    "igsn",
    "element_or_analyte",
    "analyte_reported",
    "species_or_oxide",
    "medium",
    "material",
    "measurement_basis",
    "original_value_raw",
    "original_value",
    "original_unit",
    "value_qualifier",
    "censored",
    "missing_reason",
    "normalized_value",
    "normalized_unit",
    "normalized_censoring_limit",
    "conversion_factor",
    "conversion_formula",
    "original_latitude_raw",
    "original_longitude_raw",
    "latitude",
    "longitude",
    "source_crs",
    "coordinate_transform_method",
    "coordinate_uncertainty_m",
    "sampled_at",
    "sample_depth_min_m",
    "sample_depth_max_m",
    "grain_fraction",
    "lithology",
    "geologic_unit",
    "geologic_unit_id",
    "geologic_context_source",
    "geologic_context_version",
    "geologic_match_method",
    "distance_to_geologic_boundary_m",
    "geologic_match_confidence",
    "analytical_method",
    "method_family",
    "digestion_or_extraction",
    "laboratory",
    "reference_material",
    "detection_limit",
    "detection_limit_unit",
    "source_id",
    "dataset_title",
    "dataset_doi",
    "dataset_version",
    "source_file",
    "source_row",
    "source_locator",
    "file_sha256",
    "license",
    "source_tier",
    "qc_flags",
    "operational_confidence"
  ],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "source_record_id": {"type": ["string", "null"]},
    "sample_id": {"type": ["string", "null"]},
    "sample_identity_group": {"type": ["string", "null"]},
    "replicate_group_id": {"type": ["string", "null"]},
    "igsn": {"type": ["string", "null"]},
    "element_or_analyte": {"type": "string", "minLength": 1},
    "analyte_reported": {"type": ["string", "null"]},
    "species_or_oxide": {"type": ["string", "null"]},
    "medium": {
      "type": "string",
      "enum": ["rock", "soil", "sediment", "water", "mineral", "concentrate", "unknown"]
    },
    "material": {"type": ["string", "null"]},
    "measurement_basis": {"type": ["string", "null"]},
    "original_value_raw": {"type": ["string", "null"]},
    "original_value": {"type": ["number", "null"]},
    "original_unit": {"type": ["string", "null"]},
    "value_qualifier": {
      "type": "string",
      "enum": ["reported", "approximate", "lt", "le", "gt", "ge", "bdl", "nd", "trace", "unknown"]
    },
    "censored": {"type": "boolean"},
    "missing_reason": {
      "type": ["string", "null"],
      "enum": ["not_reported", "not_analyzed", "insufficient_sample", "invalid_value", "unknown", null]
    },
    "normalized_value": {"type": ["number", "null"]},
    "normalized_unit": {"type": ["string", "null"], "enum": ["mg/kg", "ug/L", null]},
    "normalized_censoring_limit": {"type": ["number", "null"], "minimum": 0},
    "conversion_factor": {"type": ["number", "null"], "minimum": 0},
    "conversion_formula": {"type": ["string", "null"]},
    "original_latitude_raw": {"type": ["string", "null"]},
    "original_longitude_raw": {"type": ["string", "null"]},
    "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
    "source_crs": {"type": ["string", "null"]},
    "coordinate_transform_method": {"type": ["string", "null"]},
    "coordinate_uncertainty_m": {"type": ["number", "null"], "minimum": 0},
    "sampled_at": {"type": ["string", "null"]},
    "sample_depth_min_m": {"type": ["number", "null"], "minimum": 0},
    "sample_depth_max_m": {"type": ["number", "null"], "minimum": 0},
    "grain_fraction": {"type": ["string", "null"]},
    "lithology": {"type": ["string", "null"]},
    "geologic_unit": {"type": ["string", "null"]},
    "geologic_unit_id": {"type": ["string", "null"]},
    "geologic_context_source": {"type": ["string", "null"]},
    "geologic_context_version": {"type": ["string", "null"]},
    "geologic_match_method": {"type": ["string", "null"]},
    "distance_to_geologic_boundary_m": {"type": ["number", "null"], "minimum": 0},
    "geologic_match_confidence": {
      "type": ["string", "null"],
      "enum": ["high", "medium", "low", "unknown", null]
    },
    "analytical_method": {"type": ["string", "null"]},
    "method_family": {"type": ["string", "null"]},
    "digestion_or_extraction": {"type": ["string", "null"]},
    "laboratory": {"type": ["string", "null"]},
    "reference_material": {"type": ["string", "null"]},
    "detection_limit": {"type": ["number", "null"], "minimum": 0},
    "detection_limit_unit": {"type": ["string", "null"]},
    "source_id": {"type": ["string", "null"]},
    "dataset_title": {"type": ["string", "null"]},
    "dataset_doi": {"type": ["string", "null"]},
    "dataset_version": {"type": ["string", "null"]},
    "source_file": {"type": ["string", "null"]},
    "source_row": {"type": ["string", "null"]},
    "source_locator": {"type": ["string", "null"]},
    "file_sha256": {"type": ["string", "null"]},
    "license": {"type": ["string", "null"]},
    "source_tier": {"type": "string"},
    "qc_flags": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "operational_confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source", "completeness", "method", "spatial", "qc", "overall", "band"],
      "properties": {
        "version": {"const": "d2-confidence-v2"},
        "source": {"type": "number", "minimum": 0, "maximum": 1},
        "completeness": {"type": "number", "minimum": 0, "maximum": 1},
        "method": {"type": "number", "minimum": 0, "maximum": 1},
        "spatial": {"type": "number", "minimum": 0, "maximum": 1},
        "qc": {"type": "number", "minimum": 0, "maximum": 1},
        "overall": {"type": "number", "minimum": 0, "maximum": 1},
        "band": {"type": "string", "enum": ["high", "medium", "low"]}
      }
    }
  }
}
