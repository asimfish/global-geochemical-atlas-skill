{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4s:geochemistry-record:d2-v1",
  "title": "D2 standardized geochemical measurement record",
  "description": "One analyte determination with preserved original values, conservative normalization, QC and operational confidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "sample_id",
    "element_or_analyte",
    "medium",
    "measurement_basis",
    "original_value_raw",
    "original_value",
    "original_unit",
    "value_qualifier",
    "normalized_value",
    "normalized_unit",
    "normalized_censoring_limit",
    "conversion_factor",
    "conversion_formula",
    "original_latitude_raw",
    "original_longitude_raw",
    "latitude",
    "longitude",
    "source_crs",
    "coordinate_uncertainty_m",
    "sampled_at",
    "sample_depth_min_m",
    "sample_depth_max_m",
    "grain_fraction",
    "geologic_unit",
    "analytical_method",
    "digestion_or_extraction",
    "laboratory",
    "detection_limit",
    "detection_limit_unit",
    "source_id",
    "source_locator",
    "license",
    "source_tier",
    "qc_flags",
    "operational_confidence"
  ],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "sample_id": {"type": ["string", "null"]},
    "element_or_analyte": {"type": "string", "minLength": 1},
    "medium": {
      "type": "string",
      "enum": ["rock", "soil", "sediment", "water", "mineral", "concentrate", "unknown"]
    },
    "measurement_basis": {"type": ["string", "null"]},
    "original_value_raw": {"type": ["string", "null"]},
    "original_value": {"type": ["number", "null"]},
    "original_unit": {"type": ["string", "null"]},
    "value_qualifier": {
      "type": "string",
      "enum": ["reported", "approximate", "lt", "le", "gt", "ge", "bdl", "nd", "unknown"]
    },
    "normalized_value": {"type": ["number", "null"]},
    "normalized_unit": {"type": ["string", "null"], "enum": ["mg/kg", "ug/L", null]},
    "normalized_censoring_limit": {"type": ["number", "null"]},
    "conversion_factor": {"type": ["number", "null"]},
    "conversion_formula": {"type": ["string", "null"]},
    "original_latitude_raw": {"type": ["string", "null"]},
    "original_longitude_raw": {"type": ["string", "null"]},
    "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
    "source_crs": {"type": ["string", "null"]},
    "coordinate_uncertainty_m": {"type": ["number", "null"], "minimum": 0},
    "sampled_at": {"type": ["string", "null"]},
    "sample_depth_min_m": {"type": ["number", "null"], "minimum": 0},
    "sample_depth_max_m": {"type": ["number", "null"], "minimum": 0},
    "grain_fraction": {"type": ["string", "null"]},
    "geologic_unit": {"type": ["string", "null"]},
    "analytical_method": {"type": ["string", "null"]},
    "digestion_or_extraction": {"type": ["string", "null"]},
    "laboratory": {"type": ["string", "null"]},
    "detection_limit": {"type": ["number", "null"], "minimum": 0},
    "detection_limit_unit": {"type": ["string", "null"]},
    "source_id": {"type": ["string", "null"]},
    "source_locator": {"type": ["string", "null"]},
    "license": {"type": ["string", "null"]},
    "source_tier": {"type": "string"},
    "qc_flags": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "operational_confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source", "completeness", "method", "spatial", "qc", "overall", "band"],
      "properties": {
        "version": {"const": "d2-confidence-v1"},
        "source": {"type": "number", "minimum": 0, "maximum": 1},
        "completeness": {"type": "number", "minimum": 0, "maximum": 1},
        "method": {"type": "number", "minimum": 0, "maximum": 1},
        "spatial": {"type": "number", "minimum": 0, "maximum": 1},
        "qc": {"type": "number", "minimum": 0, "maximum": 1},
        "overall": {"type": "number", "minimum": 0, "maximum": 1},
        "band": {"type": "string", "enum": ["high", "medium", "low"]}
      }
    }
  }
}
