{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4s:geochemical-source-discovery-record:v1",
  "title": "D1 source discovery log record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "discovery_version",
    "round",
    "checked_at",
    "channel",
    "query",
    "source_id",
    "result",
    "evidence_url",
    "decision",
    "duplicate_of",
    "notes"
  ],
  "properties": {
    "discovery_version": {"const": "geochemical-source-discovery-v1"},
    "round": {"type": "integer", "minimum": 1},
    "checked_at": {"type": "string", "format": "date-time"},
    "channel": {"type": "string", "minLength": 1},
    "query": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "result": {"type": "string", "enum": ["approved_reference", "candidate", "metadata_lead", "duplicate", "rejected"]},
    "evidence_url": {"type": "string", "pattern": "^https://"},
    "decision": {"type": "string", "enum": ["catalogued", "excluded", "merged"]},
    "duplicate_of": {"type": ["string", "null"]},
    "notes": {"type": "string", "minLength": 1}
  }
}
