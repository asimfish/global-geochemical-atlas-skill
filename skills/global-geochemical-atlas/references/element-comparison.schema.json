{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:global-geochemical-atlas:element-comparison:v1",
  "title": "Comparable same-sample element-pair report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "comparison_version", "status", "elements", "input_sha256", "filters",
    "coverage", "statistics", "paired_records", "exclusions", "scientific_boundary"
  ],
  "properties": {
    "comparison_version": {"const": "d3-element-comparison-v1"},
    "status": {"enum": ["success", "insufficient_pairs"]},
    "elements": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {"x": {"type": "string", "minLength": 1}, "y": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "comparison_medium", "spatial_scope", "comparability_fields"],
      "properties": {
        "profile": {"$ref": "#/$defs/profileFilters"},
        "comparison_medium": {"type": ["string", "null"]},
        "spatial_scope": {"$ref": "#/$defs/spatialScope"},
        "comparability_fields": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_x_observation_count", "eligible_y_observation_count",
        "paired_sample_layer_count", "x_only_sample_layer_count",
        "y_only_sample_layer_count", "ambiguous_replicate_group_count"
      ],
      "properties": {
        "eligible_x_observation_count": {"type": "integer", "minimum": 0},
        "eligible_y_observation_count": {"type": "integer", "minimum": 0},
        "paired_sample_layer_count": {"type": "integer", "minimum": 0},
        "x_only_sample_layer_count": {"type": "integer", "minimum": 0},
        "y_only_sample_layer_count": {"type": "integer", "minimum": 0},
        "ambiguous_replicate_group_count": {"type": "integer", "minimum": 0}
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spearman_rho", "x_log10_median", "y_log10_median", "quadrant_counts"],
      "properties": {
        "spearman_rho": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
        "x_log10_median": {"type": ["number", "null"]},
        "y_log10_median": {"type": ["number", "null"]},
        "quadrant_counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "high_high": {"type": "integer", "minimum": 0},
            "high_low": {"type": "integer", "minimum": 0},
            "low_high": {"type": "integer", "minimum": 0},
            "low_low": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "paired_records": {"type": "array", "items": {"$ref": "#/$defs/pair"}},
    "exclusions": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "scientific_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "nullableText": {"type": ["string", "null"]},
    "profileFilters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element", "medium", "sample_type", "basis", "geology", "method", "method_scope", "source", "confidence"],
      "properties": {
        "element": {"$ref": "#/$defs/nullableText"},
        "medium": {"$ref": "#/$defs/nullableText"},
        "sample_type": {"$ref": "#/$defs/nullableText"},
        "basis": {"$ref": "#/$defs/nullableText"},
        "geology": {"$ref": "#/$defs/nullableText"},
        "method": {"$ref": "#/$defs/nullableText"},
        "method_scope": {"$ref": "#/$defs/nullableText"},
        "source": {"$ref": "#/$defs/nullableText"},
        "confidence": {"$ref": "#/$defs/nullableText"}
      }
    },
    "spatialScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_key", "label", "bounds", "country_code", "clip_method"],
      "properties": {
        "region_key": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["w", "s", "e", "n"],
          "properties": {
            "w": {"type": "number", "minimum": -180, "maximum": 180},
            "s": {"type": "number", "minimum": -90, "maximum": 90},
            "e": {"type": "number", "minimum": -180, "maximum": 180},
            "n": {"type": "number", "minimum": -90, "maximum": 90}
          }
        },
        "country_code": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
        "clip_method": {"type": "string", "minLength": 1}
      }
    },
    "comparability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "medium", "material", "sample_type", "soil_horizon", "sediment_environment",
        "water_fraction", "grain_fraction", "measurement_basis", "geologic_unit_raw",
        "matched_geologic_unit", "analytical_method", "method_family", "method_scope",
        "digestion_or_extraction", "normalized_unit"
      ],
      "properties": {
        "medium": {"type": "string"}, "material": {"type": "string"},
        "sample_type": {"type": "string"}, "soil_horizon": {"type": "string"},
        "sediment_environment": {"type": "string"}, "water_fraction": {"type": "string"},
        "grain_fraction": {"type": "string"}, "measurement_basis": {"type": "string"},
        "geologic_unit_raw": {"type": "string"}, "matched_geologic_unit": {"type": "string"},
        "analytical_method": {"type": "string"}, "method_family": {"type": "string"},
        "method_scope": {"type": "string"}, "digestion_or_extraction": {"type": "string"},
        "normalized_unit": {"type": "string"}
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "sample_id", "x_record_id", "y_record_id", "x_value", "y_value",
        "x_log10", "y_log10", "comparability"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "sample_id": {"type": "string", "minLength": 1},
        "x_record_id": {"type": "string", "minLength": 1},
        "y_record_id": {"type": "string", "minLength": 1},
        "x_value": {"type": "number", "exclusiveMinimum": 0},
        "y_value": {"type": "number", "exclusiveMinimum": 0},
        "x_log10": {"type": "number"},
        "y_log10": {"type": "number"},
        "comparability": {"$ref": "#/$defs/comparability"}
      }
    }
  }
}
