{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4s:d1-dataset-source:v1",
  "title": "D1 dataset source archive entity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "source_id", "title", "publisher", "dataset_doi", "dataset_version", "landing_page", "license_id", "license_url", "retrieved_at", "files"],
  "properties": {
    "schema_version": {"const": "d1-dataset-source-v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "dataset_doi": {"type": ["string", "null"]},
    "dataset_version": {"type": "string", "minLength": 1},
    "landing_page": {"type": "string", "pattern": "^https://"},
    "license_id": {"type": "string", "minLength": 1},
    "license_url": {"type": "string", "pattern": "^https://"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file_id", "filename", "source_url", "bytes"],
        "properties": {
          "file_id": {"type": "string", "minLength": 1},
          "filename": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 1},
          "file_identity": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
