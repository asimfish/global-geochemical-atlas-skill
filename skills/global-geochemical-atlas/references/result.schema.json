{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:global-geochemical-atlas:result:v1",
  "title": "Global geochemical atlas run summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "quality_status",
    "request_summary",
    "input",
    "outputs",
    "metrics",
    "coverage",
    "limitations",
    "next_actions"
  ],
  "properties": {
    "schema_version": {"const": "global-geochemical-atlas-result-v1"},
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial_success",
        "invalid_input",
        "unsupported_scope",
        "network_unavailable",
        "source_not_accessible",
        "incomplete_retrieval",
        "conflicting_evidence",
        "insufficient_background",
        "needs_human_review"
      ]
    },
    "quality_status": {"type": "string", "enum": ["no_flags", "issues_detected", "not_evaluated"]},
    "request_summary": {
      "type": "object",
      "required": ["region_bbox", "max_records", "group_by", "minimum_group_size", "robust_z_threshold"],
      "properties": {
        "region_bbox": {"type": ["array", "null"]},
        "max_records": {"type": "integer"},
        "group_by": {"type": "array", "items": {"type": "string"}},
        "minimum_group_size": {"type": "integer"},
        "robust_z_threshold": {"type": "number"}
      },
      "additionalProperties": true
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename", "sha256", "record_count", "synthetic_demo", "data_mode",
        "not_for_scientific_interpretation"
      ],
      "properties": {
        "filename": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "record_count": {"type": "integer", "minimum": 0},
        "synthetic_demo": {"type": "boolean"},
        "data_mode": {"enum": ["fixture", "online", "cached", "input", "synthetic_fixture", "not_evaluated"]},
        "not_for_scientific_interpretation": {"type": "boolean"}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_count",
        "standardized_record_count",
        "valid_coordinate_count",
        "censored_record_count",
        "candidate_anomaly_count",
        "batch_qc_failed_or_incomplete_count",
        "candidate_anomaly_region_count",
        "iteration_action_required_count",
        "iteration_review_required_count"
      ],
      "properties": {
        "record_count": {"type": "integer", "minimum": 0},
        "standardized_record_count": {"type": "integer", "minimum": 0},
        "valid_coordinate_count": {"type": "integer", "minimum": 0},
        "censored_record_count": {"type": "integer", "minimum": 0},
        "candidate_anomaly_count": {"type": "integer", "minimum": 0},
        "batch_qc_failed_or_incomplete_count": {"type": "integer", "minimum": 0},
        "candidate_anomaly_region_count": {"type": "integer", "minimum": 0},
        "iteration_action_required_count": {"type": "integer", "minimum": 0},
        "iteration_review_required_count": {"type": "integer", "minimum": 0}
      }
    },
    "coverage": {
      "type": "object",
      "required": ["elements", "media", "coordinate_rate", "standardization_rate", "bbox", "interpolation"],
      "properties": {
        "elements": {"type": "array", "items": {"type": "string"}},
        "media": {"type": "array", "items": {"type": "string"}},
        "coordinate_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "standardization_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "bbox": {"type": ["array", "null"]},
        "interpolation": {"const": false}
      },
      "additionalProperties": true
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "next_actions": {"type": "array", "items": {"type": "string"}},
    "artifact_transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_version", "state", "commit_marker", "input_sha256",
        "artifacts", "mutation_rule"
      ],
      "properties": {
        "transaction_version": {"const": "geochemical-workflow-artifact-transaction-v1"},
        "state": {"const": "committed"},
        "commit_marker": {"const": "run_summary.json"},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifacts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["filename", "bytes", "sha256"],
            "properties": {
              "filename": {"type": "string", "minLength": 1},
              "bytes": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "mutation_rule": {"type": "string", "minLength": 1}
      }
    },
    "map_report": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "map_version": {"type": "string"},
        "mapped_record_count": {"type": "integer", "minimum": 0},
        "source_mappable_record_count": {"type": "integer", "minimum": 0},
        "scope_excluded_mappable_record_count": {"type": "integer", "minimum": 0},
        "display_sample_count": {"type": "integer", "minimum": 0},
        "unmappable_record_count": {"type": "integer", "minimum": 0},
        "candidate_record_count": {"type": "integer", "minimum": 0},
        "candidate_anomaly_region_count": {"type": "integer", "minimum": 0},
        "default_view": {"enum": ["all_data_sample_deduplicated", "profile_driven_task_view", "regional_scope_task_view"]},
        "embedded_payload_schema": {"const": "d3-compact-payload-v1"},
        "anomaly_region_render_mode": {"const": "zoom-adaptive-anomaly-bubbles-v1"},
        "visualization_profile": {
          "type": "object",
          "required": ["schema_version", "story", "spatial_scope", "default_region", "filters", "comparison", "display"],
          "properties": {
            "schema_version": {"const": "d3-visualization-profile-v2"},
            "story": {"enum": ["overview", "coverage", "anomaly", "comparison", "database", "evidence"]},
            "spatial_scope": {"enum": ["global", "regional"]},
            "default_region": {"type": "string"},
            "filters": {"type": "object"},
            "comparison": {"type": "object"},
            "display": {"type": "object"}
          },
          "additionalProperties": true
        },
        "visualization_profile_warnings": {
          "type": "array",
          "items": {"type": "string"}
        },
        "spatial_scope": {
          "type": "object",
          "required": ["mode", "region_key", "region_label", "bounds", "output_clipped"],
          "properties": {
            "mode": {"enum": ["global", "regional"]},
            "region_key": {"type": "string"},
            "region_label": {"type": "string"},
            "bounds": {
              "type": "object",
              "required": ["w", "s", "e", "n"]
            },
            "output_clipped": {"type": "boolean"},
            "clip_method": {"type": "string", "enum": ["bbox", "country_polygon_and_bbox"]},
            "country_code": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "visualization_modes": {
          "type": "array",
          "items": {
            "enum": [
              "distribution_points",
              "sample_density_heatmap",
              "element_pair_comparison",
              "candidate_anomaly_region_aggregation",
              "fdr_screened_candidate_anomaly_regions"
            ]
          },
          "uniqueItems": true
        },
        "region_presets": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "region_coverage": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["label", "bounds", "record_count", "sample_count", "elements", "media", "administrative_clip", "clip_method"],
            "properties": {
              "label": {"type": "string"},
              "bounds": {"type": "object"},
              "record_count": {"type": "integer", "minimum": 0},
              "sample_count": {"type": "integer", "minimum": 0},
              "elements": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "media": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "administrative_clip": {"type": "boolean"},
              "clip_method": {"type": "string", "enum": ["bbox", "country_polygon_and_bbox"]}
            },
            "additionalProperties": false
          }
        },
        "external_assets": {"const": 0},
        "interpolation": {"const": false},
        "html_bytes": {"type": "integer", "minimum": 1, "maximum": 100000000},
        "samples_geojson_bytes": {"type": "integer", "minimum": 1, "maximum": 100000000},
        "basemap": {
          "type": "object",
          "required": ["asset_version", "scale", "license", "embedded"],
          "properties": {
            "asset_version": {"const": "ai4s-natural-earth-land-v1"},
            "scale": {"const": "1:110m"},
            "license": {"const": "public domain"},
            "embedded": {"const": true}
          },
          "additionalProperties": true
        }
      }
    }
  }
}
