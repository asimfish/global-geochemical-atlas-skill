{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:global-geochemical-atlas:request:v6",
  "title": "Global geochemical atlas evidence-aware request",
  "type": "object",
  "additionalProperties": false,
  "required": ["elements", "region", "media"],
  "properties": {
    "elements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "region": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["bbox"],
          "properties": {
            "bbox": {
              "type": "array",
              "prefixItems": [
                {"type": "number", "minimum": -180, "maximum": 180},
                {"type": "number", "minimum": -90, "maximum": 90},
                {"type": "number", "minimum": -180, "maximum": 180},
                {"type": "number", "minimum": -90, "maximum": 90}
              ],
              "minItems": 4,
              "maxItems": 4
            }
          }
        }
      ]
    },
    "media": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["rock", "soil", "sediment", "water", "mineral", "concentrate"]
      }
    },
    "coverage_mode": {
      "type": "string",
      "enum": ["fixed", "maximize_evidence_breadth"],
      "description": "Use fixed only for an explicitly closed element/media set. Open atlas tasks with 'at least N' use maximize_evidence_breadth; N remains a lower bound."
    },
    "minimum_elements": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "User-stated lower bound; must not exceed the selected elements array length."
    },
    "minimum_media": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "User-stated lower bound; must not exceed the selected media array length."
    },
    "spatial_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["land", "inland_water", "marine"]},
      "description": "First-class sampling domains. If omitted, they are conservatively derived from media: rock/soil imply land; sediment implies land + inland_water + marine; water implies inland_water + marine."
    },
    "adjacent_marine_distance_km": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000,
      "description": "For a named-country request that includes marine, maximum distance from the frozen Admin-0 boundary for source-labelled marine observations. Runtime default is 600 km; this is an analysis buffer, never a territorial/EEZ claim. Otherwise it must be 0."
    },
    "measurement_basis": {
      "type": ["array", "null"],
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "geology_units": {
      "type": ["array", "null"],
      "minItems": 1,
      "maxItems": 50,
      "items": {"type": "string", "minLength": 1, "maxLength": 160},
      "uniqueItems": true,
      "description": "Exact normalized geological-unit labels to retain after source/geology matching."
    },
    "geology_match": {
      "type": "string",
      "enum": ["reported_or_matched", "reported", "matched"],
      "default": "reported_or_matched"
    },
    "time_range": {
      "type": ["array", "null"],
      "prefixItems": [
        {"type": "string", "pattern": "^[0-9]{4}(?:-|$)"},
        {"type": "string", "pattern": "^[0-9]{4}(?:-|$)"}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "sources": {
      "oneOf": [
        {"const": "auto"},
        {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      ],
      "default": "auto"
    },
    "output_formats": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["csv", "json", "geojson", "html_map"]},
      "default": ["csv", "json", "geojson", "html_map"]
    },
    "target_crs": {"const": "EPSG:4326", "default": "EPSG:4326"},
    "license_policy": {"const": "open_only", "default": "open_only"},
    "research_use_policy": {
      "type": "string",
      "enum": ["permitted_research", "open_research_only", "include_permission_required"],
      "default": "permitted_research"
    },
    "minimum_evidence_tier": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "U"],
      "default": "D"
    },
    "minimum_use_mode": {
      "type": "string",
      "enum": ["discovery", "raw_observation", "normalized_analysis", "benchmark_ready"],
      "default": "normalized_analysis"
    },
    "max_records": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200000,
      "description": "Optional explicit ceiling. Runtime default is 50000 for fixed requests and 200000 for maximize_evidence_breadth so an open atlas is not silently truncated at the fixed-request ceiling."
    },
    "offline": {"type": "boolean", "default": false}
  }
}
