{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:global-geochemical-atlas:audit-receipt:v1",
  "title": "Adversarial audit receipt",
  "description": "Referee-grade receipt produced by scripts/adversarial_audit.py. A verdict is only admissible when canary calibration proves the auditing checks catch every planted defect class; an auditor that cannot find planted defects must not acquit real data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_schema", "audit_version", "mode", "output_dir", "calibration",
    "checks", "finding_count", "error_count", "findings", "verdict", "principle"
  ],
  "properties": {
    "receipt_schema": {"const": "urn:global-geochemical-atlas:audit-receipt:v1"},
    "audit_version": {"type": "string", "minLength": 1},
    "mode": {"enum": ["scripted"]},
    "output_dir": {"type": "string", "minLength": 1},
    "calibration": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "required": ["seed", "planted", "caught", "missed", "recall", "admissible"],
      "properties": {
        "seed": {"type": "integer"},
        "planted": {"type": "integer", "minimum": 0},
        "caught": {"type": "integer", "minimum": 0},
        "missed": {"type": "array"},
        "recall": {"type": "number", "minimum": 0, "maximum": 1},
        "admissible": {"type": "boolean"},
        "shadow_dir": {"type": "string"},
        "truth_file": {"type": "string"}
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "status", "finding_count"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail"]},
          "finding_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "finding_count": {"type": "integer", "minimum": 0},
    "error_count": {"type": "integer", "minimum": 0},
    "warning_count": {"type": "integer", "minimum": 0},
    "scope_notes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "description": "One sentence per warning finding; the final answer may only quote the affected numbers together with these scope sentences (a scoped claim narrows, it must not silently widen)."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "defect_class", "severity", "detail"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "defect_class": {"type": "string", "minLength": 1},
          "severity": {"enum": ["error", "warning", "suspicion"]},
          "detail": {"type": "string", "minLength": 1},
          "file": {"type": ["string", "null"]},
          "record_id": {"type": ["string", "null"]},
          "suggested_action": {"type": "string"}
        }
      }
    },
    "verdict": {
      "enum": ["pass", "pass_scope_narrowed", "fail", "inadmissible_uncalibrated", "inadmissible_calibration_failed"]
    },
    "principle": {"type": "string", "minLength": 1}
  }
}
