{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:global-geochemical-atlas:request-execution:v5",
  "title": "Request-driven atlas execution evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_version",
    "status",
    "mode",
    "analysis_profile",
    "coordinate_mode",
    "timing",
    "skill_snapshot",
    "geology_grid",
    "record_counts",
    "source_outcomes",
    "acquisition_manifests",
    "route_status",
    "coverage_status",
    "route_resolution",
    "execution_coverage_status",
    "request_coverage",
    "warnings"
  ],
  "properties": {
    "execution_version": {"const": "geochemical-request-execution-v5"},
    "status": {"type": "string", "enum": ["success", "partial_success"]},
    "mode": {"type": "string", "minLength": 1},
    "analysis_profile": {"type": "string", "enum": ["demo", "production"]},
    "coordinate_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "effective"],
      "properties": {
        "requested": {"type": "string", "enum": ["auto", "canonical", "reported"]},
        "effective": {"type": "string", "enum": ["canonical", "reported"]}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_task_limit_seconds",
        "internal_budget_seconds",
        "workflow_reserve_seconds",
        "elapsed_seconds",
        "completed_within_internal_budget",
        "deadline_policy"
      ],
      "properties": {
        "official_task_limit_seconds": {"const": 43200.0},
        "internal_budget_seconds": {"type": "number", "minimum": 1, "maximum": 43200},
        "workflow_reserve_seconds": {"type": "number", "minimum": 5},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "completed_within_internal_budget": {"const": true},
        "deadline_policy": {"const": "single_monotonic_deadline_v1"}
      }
    },
    "skill_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm", "start_sha256", "end_sha256",
        "stable_during_execution", "file_count", "total_bytes",
        "stability_verification"
      ],
      "properties": {
        "algorithm": {"const": "skill-tree-sha256-v1"},
        "start_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "end_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stable_during_execution": {"const": true},
        "file_count": {"type": "integer", "minimum": 1},
        "total_bytes": {"type": "integer", "minimum": 1},
        "stability_verification": {"const": "path-and-stat-identity-v1"}
      }
    },
    "geology_grid": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["filename", "sha256"],
          "properties": {
            "filename": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "record_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_request_filters", "after_request_filters"],
      "properties": {
        "before_request_filters": {"type": "integer", "minimum": 0},
        "after_request_filters": {"type": "integer", "minimum": 0}
      }
    },
    "source_outcomes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id", "status", "allocated_max_records", "record_count",
          "manifest_sha256", "error"
        ],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["success", "failed"]},
          "allocated_max_records": {"type": "integer", "minimum": 1},
          "record_count": {"type": "integer", "minimum": 0},
          "manifest_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "error": {"type": ["string", "null"]}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "success"}}},
            "then": {
              "properties": {
                "record_count": {"type": "integer", "minimum": 1},
                "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "error": {"type": "null"}
              }
            }
          },
          {
            "if": {"properties": {"status": {"const": "failed"}}},
            "then": {
              "properties": {
                "record_count": {"const": 0},
                "manifest_sha256": {"type": "null"},
                "error": {"type": "string", "minLength": 1}
              }
            }
          }
        ]
      }
    },
    "acquisition_manifests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "source_id", "path", "sha256"],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "request_filtered_manifest",
              "parent_source_manifest",
              "source_manifest"
            ]
          },
          "source_id": {"type": ["string", "null"], "minLength": 1},
          "path": {
            "type": "string",
            "pattern": "^acquisition/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "allOf": [
          {
            "if": {"properties": {"role": {"const": "source_manifest"}}},
            "then": {
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              }
            },
            "else": {"properties": {"source_id": {"type": "null"}}}
          }
        ]
      }
    },
    "route_status": {
      "type": "string",
      "enum": ["ready", "partial", "needs_human_review", "unsupported_scope"]
    },
    "coverage_status": {
      "type": "string",
      "enum": ["covered", "partial", "uncovered", "unknown"]
    },
    "route_resolution": {
      "type": "string",
      "enum": [
        "offline_fixture_hash_verified",
        "routed_source_evidence_verified",
        "routed_multi_source_evidence_verified",
        "provided_input_processed"
      ]
    },
    "execution_coverage_status": {
      "type": "string",
      "enum": ["covered", "partial", "uncovered", "unknown"]
    },
    "request_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "dimensions"],
      "properties": {
        "status": {"type": "string", "enum": ["complete", "partial"]},
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["elements", "media"],
          "properties": {
            "elements": {"$ref": "#/$defs/requestDimension"},
            "media": {"$ref": "#/$defs/requestDimension"},
            "spatial_domains": {"$ref": "#/$defs/requestDimension"}
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "requestDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "observed", "missing", "status"],
      "properties": {
        "requested": {
          "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
        },
        "observed": {
          "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
        },
        "missing": {
          "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
        },
        "status": {"type": "string", "enum": ["complete", "partial"]}
      }
    }
  }
}
