{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:global-geochemical-atlas:request-execution:v2",
  "title": "Request-driven atlas execution evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_version",
    "status",
    "mode",
    "analysis_profile",
    "geology_grid",
    "record_counts",
    "source_outcomes",
    "acquisition_manifests",
    "route_status",
    "coverage_status",
    "route_resolution",
    "execution_coverage_status",
    "warnings"
  ],
  "properties": {
    "execution_version": {"const": "geochemical-request-execution-v2"},
    "status": {"type": "string", "enum": ["success", "partial_success"]},
    "mode": {"type": "string", "minLength": 1},
    "analysis_profile": {"type": "string", "enum": ["demo", "production"]},
    "geology_grid": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "$ref": "#/$defs/fileIdentity"
        }
      ]
    },
    "record_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_request_filters", "after_request_filters"],
      "properties": {
        "before_request_filters": {"type": "integer", "minimum": 0},
        "after_request_filters": {"type": "integer", "minimum": 0}
      }
    },
    "source_outcomes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id", "status", "allocated_max_records", "record_count",
          "manifest_identity", "error"
        ],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["success", "failed"]},
          "allocated_max_records": {"type": "integer", "minimum": 1},
          "record_count": {"type": "integer", "minimum": 0},
          "manifest_identity": {
            "oneOf": [{"type": "null"}, {"$ref": "#/$defs/fileIdentity"}]
          },
          "error": {"type": ["string", "null"]}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "success"}}},
            "then": {
              "properties": {
                "record_count": {"type": "integer", "minimum": 1},
                "manifest_identity": {"$ref": "#/$defs/fileIdentity"},
                "error": {"type": "null"}
              }
            }
          },
          {
            "if": {"properties": {"status": {"const": "failed"}}},
            "then": {
              "properties": {
                "record_count": {"const": 0},
                "manifest_identity": {"type": "null"},
                "error": {"type": "string", "minLength": 1}
              }
            }
          }
        ]
      }
    },
    "acquisition_manifests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "source_id", "path", "identity"],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "request_filtered_manifest",
              "parent_source_manifest",
              "source_manifest"
            ]
          },
          "source_id": {"type": ["string", "null"], "minLength": 1},
          "path": {
            "type": "string",
            "pattern": "^acquisition/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
          },
          "identity": {"$ref": "#/$defs/fileIdentity"}
        },
        "allOf": [
          {
            "if": {"properties": {"role": {"const": "source_manifest"}}},
            "then": {
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              }
            },
            "else": {"properties": {"source_id": {"type": "null"}}}
          }
        ]
      }
    },
    "route_status": {
      "type": "string",
      "enum": ["ready", "partial", "needs_human_review", "unsupported_scope"]
    },
    "coverage_status": {
      "type": "string",
      "enum": ["covered", "partial", "uncovered", "unknown"]
    },
    "route_resolution": {
      "type": "string",
      "enum": [
        "offline_fixture_manifest_verified",
        "routed_source_evidence_verified",
        "routed_multi_source_evidence_verified",
        "provided_input_processed"
      ]
    },
    "execution_coverage_status": {
      "type": "string",
      "enum": ["covered", "partial", "uncovered", "unknown"]
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "fileIdentity": {
      "type": "object",
      "required": ["filename", "bytes"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "columns": {"type": "array", "items": {"type": "string"}},
        "row_count": {"type": "integer", "minimum": 0},
        "top_level_keys": {"type": "array", "items": {"type": "string"}},
        "schema_version": {"type": "string"},
        "manifest_version": {"type": "string"},
        "run_version": {"type": "string"},
        "member_count": {"type": "integer", "minimum": 0},
        "members": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    }
  }
}
