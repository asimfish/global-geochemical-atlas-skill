{
  "schema_version": "qwen-uplift-discovery-contract-v1",
  "request": {
    "region": "global",
    "elements": ["As", "Cu", "Fe", "Ni", "Pb", "Zn"],
    "media": ["rock", "soil", "sediment", "water"],
    "sources": "auto",
    "scope": "bounded_best_effort",
    "license_policy": "open_or_research_reusable",
    "target_crs": "EPSG:4326",
    "max_records": 50000
  },
  "anchor_semantics": "The hash-pinned resources in sources.json are minimum truth anchors, not an exhaustive source list or a global coverage denominator.",
  "acquisition": {
    "data_directory": "discovered",
    "manifest": "discovered_manifest.json",
    "manifest_schema_version": "qwen-uplift-discovered-manifest-v1",
    "network_phase": "public_scientific_sources_only",
    "processing_phase": "offline",
    "maximum_single_file_bytes": 50000000,
    "maximum_total_discovered_bytes": 150000000,
    "discovery_planning_budget_seconds": 240
  },
  "continuation_policy": {
    "minimum_targets_are_a_floor_not_a_stop_condition": true,
    "continue_while_within_budget_and_candidate_adds": [
      "new_medium_element_region_platform_cell",
      "better_coordinate_method_or_geology_completeness",
      "independent_cross_source_evidence"
    ],
    "prioritize": [
      "missing_media",
      "missing_elements",
      "missing_world_regions",
      "independent_platforms",
      "within_cell_density"
    ],
    "maximum_records_selection": "deterministic_stratified_preserve_rare_source_platform_medium_element_region_cells",
    "allowed_stop_reasons": [
      "discovery_budget_exhausted",
      "record_cap_reached",
      "byte_cap_reached",
      "no_more_eligible_candidates",
      "partial_success_external_failures"
    ]
  },
  "minimum_public_development_targets": {
    "candidate_source_count": 8,
    "searched_platform_count": 5,
    "verified_geochemical_source_count": 6,
    "verified_additional_source_count": 2,
    "verified_platform_count": 3,
    "additional_observation_count": 200,
    "additional_unique_sample_count": 30,
    "required_media": ["rock", "soil", "sediment", "water"],
    "required_elements": ["As", "Cu", "Fe", "Ni", "Pb", "Zn"],
    "required_additional_media": ["rock"]
  },
  "candidate_statuses": ["selected", "rejected", "failed"],
  "required_discovery_report_fields": [
    "schema_version",
    "request",
    "started_at",
    "cutoff_at",
    "active_discovery_seconds",
    "stop_reason",
    "remaining_candidates",
    "selection_policy",
    "candidates",
    "claim_boundary"
  ],
  "required_discovered_resource_fields": [
    "source_id",
    "platform",
    "dataset_title",
    "dataset_doi",
    "dataset_version",
    "license",
    "media",
    "authority_url",
    "download_url",
    "locator_prefix",
    "file",
    "bytes",
    "sha256",
    "accessed_at",
    "query"
  ],
  "claim_boundary": "Meeting these public minimums demonstrates bounded multi-platform acquisition, not exhaustive global coverage. Formal breadth scoring requires a private source registry and online authority verification."
}
