{
  "schema_version": "gga-model-gateway-policy-v1",
  "evaluation_gateway_url": "https://ai.chipcloud.cc",
  "anthropic_base_url": "https://token-plan.cn-beijing.maas.aliyuncs.com/apps/anthropic",
  "anthropic_messages_path": "/v1/messages",
  "network": {
    "tls_verification_required": true,
    "allowed_domains": [
      "ai.chipcloud.cc",
      "token-plan.cn-beijing.maas.aliyuncs.com"
    ],
    "direct_candidate_egress": false,
    "egress_mode": "internal_network_via_allowlist_proxy"
  },
  "routing": {
    "primary": {
      "display_name": "Qwen3.8-Max",
      "model_id": "qwen3.8-max",
      "opencode_model": "alibaba-token-plan-cn/qwen3.8-max",
      "capabilities": [
        "text_generation",
        "reasoning",
        "vision_understanding"
      ]
    },
    "fallbacks": [
      {
        "display_name": "Qwen3-vl-Plus",
        "model_id": "qwen3-vl-plus",
        "opencode_model": "alibaba-token-plan-cn/qwen3-vl-plus",
        "route": "multimodal_understanding"
      },
      {
        "display_name": "GLM 5.2",
        "model_id": "glm-5.2",
        "opencode_model": "alibaba-token-plan-cn/glm-5.2",
        "route": "text_only"
      },
      {
        "display_name": "Wan2.7-Image-Pro",
        "model_id": "wan2.7-image-pro",
        "opencode_model": null,
        "route": "text_to_image",
        "invocation": "gateway_managed_image_api"
      }
    ],
    "fallback_activation": "official_primary_service_unavailable_only",
    "service_unavailable_signals": [
      "http_502",
      "http_503",
      "http_504",
      "connect_timeout_after_retry"
    ],
    "not_service_unavailable_signals": [
      "http_400",
      "http_401",
      "http_403",
      "http_404",
      "http_429",
      "tls_verification_failure",
      "invalid_response"
    ],
    "automatic_fallback": false,
    "legacy_models_disabled": [
      "K3"
    ]
  },
  "generation": {
    "opencode_version": "1.18.14",
    "protocol": "anthropic_compatible_messages",
    "temperature": 0.6,
    "thinking": {
      "type": "disabled"
    }
  },
  "campaign": {
    "first_round_stage_repeats": [
      2,
      16
    ],
    "fresh_opencode_session_per_repeat": true,
    "whole_batch_max_runtime_seconds": 43200
  },
  "submission": {
    "format_affected_by_model_selection": false
  },
  "runtime": {
    "cpu_cores": 2,
    "memory_bytes": 4294967296,
    "memory_swap_total_bytes": 4294967296,
    "pids_limit": 256,
    "gpu_count": 0,
    "max_runtime_seconds": 43200
  }
}
