{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4s:global-geochemical-atlas:evaluation-report:v1",
  "title": "Unified evaluation report for Q01-Q24, host uplift and Docker uplift",
  "type": "object",
  "required": [
    "schema_version", "experiment", "fairness", "d1", "d2", "d3",
    "deliverables", "score", "scientific_red_lines"
  ],
  "properties": {
    "schema_version": {"const": "global-geochemical-evaluation-report-v1"},
    "experiment": {
      "type": "object",
      "required": ["runtime", "condition", "run_id", "independent_agent_session", "submission_hashes", "manifest"],
      "properties": {
        "runtime": {"enum": ["q01-q24", "host-uplift", "docker-uplift"]},
        "condition": {"enum": ["B0", "S0"]},
        "run_id": {"type": "string", "minLength": 1},
        "independent_agent_session": {"type": "boolean"},
        "submission_dir": {"type": "string"},
        "submission_hashes": {"type": "object"},
        "manifest": {"type": "object"}
      }
    },
    "fairness": {
      "type": "object",
      "required": ["candidate_never_saw_hidden_checker", "external_browser_audit_hash_bound", "eligible_run_component"],
      "properties": {
        "candidate_never_saw_hidden_checker": {"type": "boolean"},
        "external_browser_audit_hash_bound": {"type": "boolean"},
        "eligible_run_component": {"type": "boolean"},
        "three_run_requirement": {"type": "string"}
      }
    },
    "d1": {
      "type": "object",
      "required": [
        "measurement_records", "unique_samples", "unique_reported_locations", "source_count",
        "discovery_candidate_count", "searched_platform_count", "media_counts", "missing_required_media",
        "element_count", "method_completeness", "geology_completeness",
        "coordinate_evidence_completeness", "record_provenance_completeness", "claim_boundary"
      ]
    },
    "d2": {
      "type": "object",
      "required": [
        "input_records", "output_records", "row_preservation", "normalized_records",
        "conversion_trace_rate", "explicit_unit_failure_records", "inferred_unit_records",
        "censored_records", "canonical_coordinate_records", "unique_canonical_locations",
        "geology_context_rate", "provenance_continuity_rate", "qc_flag_counts",
        "confidence_band_counts", "anomaly_candidates", "anomaly_directions"
      ]
    },
    "d3": {
      "type": "object",
      "required": [
        "browser_audit", "browser_audit_bound", "browser_usable",
        "map_measurement_features", "map_unique_locations", "samples_geojson_valid",
        "measurement_vs_location_semantics"
      ]
    },
    "deliverables": {
      "type": "object",
      "required": [
        "interactive_map", "standardized_database", "sources_and_confidence",
        "anomaly_results", "reusable_skill_document"
      ],
      "properties": {
        "interactive_map": {"$ref": "#/$defs/artifact"},
        "standardized_database": {"$ref": "#/$defs/artifact"},
        "sources_and_confidence": {"$ref": "#/$defs/artifact"},
        "anomaly_results": {"$ref": "#/$defs/artifact"},
        "reusable_skill_document": {"$ref": "#/$defs/artifact"}
      },
      "additionalProperties": false
    },
    "score": {
      "type": "object",
      "required": ["observed", "maximum", "ceiling_saturated", "source"],
      "properties": {
        "observed": {"type": ["number", "null"]},
        "maximum": {"type": "number"},
        "ceiling_saturated": {"type": "boolean"},
        "source": {"type": ["string", "null"]},
        "descriptive_partial_mean": {"type": ["number", "null"]},
        "complete_score_count": {"type": "integer", "minimum": 0},
        "task_report_count": {"type": "integer", "minimum": 0}
      }
    },
    "benchmark": {
      "type": "object",
      "required": ["scope", "question_count", "task_report_count", "complete_score_count", "stage_summaries", "task_results", "claim_boundary"]
    },
    "scientific_red_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "severity": {"enum": ["warning", "error"]}
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["present", "valid", "usable", "filename", "bytes", "sha256", "detail"],
      "properties": {
        "present": {"type": "boolean"},
        "valid": {"type": "boolean"},
        "usable": {"type": "boolean"},
        "filename": {"type": "string"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "detail": {}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
