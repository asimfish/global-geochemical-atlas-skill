{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p08.evidence-index.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "eval_version", "contract_sha256", "overall_status", "claims", "numeric_traceability", "limitations"],
  "properties": {
    "schema_version": {"const": "p08.evidence-index.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "eval_version": {"const": "1.0.0"},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "overall_status": {"enum": ["READY", "NOT_READY"]},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "plan_id", "claim_type", "statement", "status", "readiness", "evidence", "limitations"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "plan_id": {"type": "string", "pattern": "^P[0-9]{2}$"},
          "claim_type": {"enum": ["contract", "implementation", "reliability", "environment", "scoring", "integration", "statistics", "report"]},
          "statement": {"type": "string", "minLength": 1},
          "status": {"enum": ["verified", "limited", "missing", "tbd", "blocked_external"]},
          "readiness": {"enum": ["ready", "not_ready", "unknown"]},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256", "bytes", "role"],
              "properties": {
                "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
                "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
                "bytes": {"type": ["integer", "null"], "minimum": 0},
                "role": {"type": "string", "minLength": 1}
              }
            }
          },
          "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "numeric_traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "required_random_samples", "available_claims", "chains", "blocker"],
      "properties": {
        "status": {"enum": ["verified", "tbd", "missing"]},
        "required_random_samples": {"const": 3},
        "available_claims": {"type": "integer", "minimum": 0},
        "chains": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim_id", "value", "units", "links"],
            "properties": {
              "claim_id": {"type": "string"},
              "value": {"type": ["number", "integer", "string"]},
              "units": {"type": ["string", "null"]},
              "links": {
                "type": "array", "minItems": 4, "maxItems": 4,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["layer", "path", "sha256", "selector"],
                  "properties": {
                    "layer": {"enum": ["report", "aggregate", "score", "raw"]},
                    "path": {"type": "string"},
                    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "selector": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        },
        "blocker": {"type": ["string", "null"]}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
