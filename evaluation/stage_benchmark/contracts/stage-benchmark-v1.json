{
  "benchmark_version": "geochemical-stage-benchmark-v1",
  "profile": "expanded-global-real-v1",
  "scientific_scope": "frozen_real_data_workflow_benchmark_not_global_population_estimate",
  "task_requirements": {
    "d1": [
      "collect element values from rock, soil, sediment and water",
      "retain sample coordinates, source CRS, geology, analytical method and measurement basis",
      "retain record-level source, version, license, locator and file hash evidence",
      "report geographic and source coverage gaps without treating blank regions as zero"
    ],
    "d2": [
      "standardize units without destroying original values or censor qualifiers",
      "validate coordinates and preserve documented spatial/geologic matches",
      "perform quality control and decomposed operational-confidence scoring",
      "screen high and low candidate anomalies only within comparable background groups",
      "close the input/output provenance hash chain"
    ],
    "d3": [
      "produce an offline interactive element distribution map",
      "expose the standardized database, source evidence, confidence and anomaly results",
      "support element, region, geology, medium, method, source and confidence filters",
      "support sample-density heatmaps and comparable element-pair views",
      "make coverage gaps, QC limitations and non-causal anomaly boundaries visible"
    ]
  },
